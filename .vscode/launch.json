{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cortex Debug (ST-Link)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/Debug/Balance_car.elf", // 确保路径对应
      //"executable": "${workspaceFolder}/build/Release/Balance_car.elf", // 确保路径对应
      "configFiles": [
        "interface/stlink.cfg",   // 切换为 stlink.cfg
        "target/stm32f1x.cfg"     // STM32F1 芯片
      ],
      "runToEntryPoint": "main",
      "showDevDebugOutput": "none"
    }
  ]
}