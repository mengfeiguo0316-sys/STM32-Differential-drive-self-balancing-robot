{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cortex Debug (ST-Link)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/Debug/Balance_car.elf",
      
      "servertype": "openocd",
      "configFiles": [
        "interface/stlink.cfg",          // 改为 ST-Link 驱动脚本
        "target/stm32f1x.cfg"            // 芯片系列脚本不变
      ],
      
      "runToEntryPoint": "main",
      "showDevDebugOutput": "none"
    }
  ]
}